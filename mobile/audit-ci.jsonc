{
  // Blocking SCA gate for the Expo / React Native mobile app (npm lockfile).
  // Fails CI on high/critical advisories. See docs/SUPPLY_CHAIN.md.
  //
  // Runtime vs. development dependencies:
  //   - PRODUCTION deps (react-native, @react-navigation/*, expo-* — the code
  //     actually bundled onto the device by EAS/Expo) carry NO high/critical
  //     advisory. A new high/critical in a shipped dependency MUST fail this job.
  //   - The allowlisted advisories below are all in code that runs on a
  //     developer's or EAS build machine, never inside the Metro bundle
  //     installed on a device. Each documents why no bump clears it.
  //
  // brace-expansion is NOT allowlisted: it is forced to 5.0.12 via a blanket
  // npm `override` in package.json. 5.0.10 and 5.0.11 are the patched versions
  // for the two stack-exhaustion advisories (GHSA-6j4f-fj2g-mc7p and
  // GHSA-qhr7-859c-m2p7, both high, published 2026-09-29), which supersede the
  // earlier GHSA-3jxr-9vmj-r5cp / GHSA-mh99-v99m-4gvg pair the override was
  // first added for. serve-handler's minimatch@3 still tolerates the 5.x export
  // shape because our rewrite patterns contain no braces, so expand() is never
  // invoked. The uuid moderate sits below this high+ gate. Keep the allowlist
  // minimal so a genuinely new high/critical still fails the job.
  //
  // Each exception documents owner + reason + review date. Prune an entry once
  // its dependency is bumped past the patched version.
  "high": true,
  "allowlist": [
    // owner: security@kube-coder | review: 2026-10-02 | dev-only (vitest test UI)
    "GHSA-5xrq-8626-4rwp", // vitest  <=3.2.5  UI server arbitrary file read/exec — needs vitest v4
    // owner: security@kube-coder | review: 2026-10-02 | dev-only (vite via vitest)
    "GHSA-fx2h-pf6j-xcff", // vite    <=6.4.2  server.fs.deny bypass (Windows) — cleared by vitest v4
    // owner: security@kube-coder | review: 2026-10-02 | build-time only, NO FIX PUBLISHED
    //
    // node-forge <=1.4.0 accepts extra nested DigestAlgorithm elements when
    // verifying RSA PKCS#1 v1.5 signatures. first_patched_version is null —
    // there is no release to bump to, so this cannot be resolved by a version
    // change. The advisory itself is not new (published 2026-09-03); it began
    // failing this job on 2026-10-01 when its affected range was widened to
    // include 1.4.0, which is why it appeared across all branches at once.
    //
    // Reachable only through the Expo CLI toolchain — `expo` > `@expo/cli` and
    // `@expo/code-signing-certificates` — which runs on the developer/EAS build
    // machine. It is not imported by app code, so Metro does not bundle it onto
    // a device, and nothing in the app verifies attacker-supplied RSA
    // signatures with it at runtime.
    //
    // Re-check when Expo ships a release that moves off node-forge, or when
    // node-forge publishes a patched line.
    "GHSA-86w9-cpqp-85rv"  // node-forge <=1.4.0  RSA PKCS#1 v1.5 signature forgery — no patch exists
  ],
  "report-type": "summary"
}
